# Скопируй в server/.env и заполни. Файл .env НЕ коммитить!
# Строки подключения к Neon (ветка dev) выдаёт владелец проекта лично.

# Подключение через pooler (для приложения)
DATABASE_URL=""
# Прямое подключение (для миграций Prisma)
DIRECT_URL=""

# Секрет для JWT (длинная случайная строка, у каждого свой локально)
JWT_SECRET=""

# Адрес клиента, которому разрешён CORS (можно несколько через запятую)
CORS_ORIGIN="http://localhost:5173"

# На продакшене (Render) обязательно "production": включает secure-cookie
NODE_ENV="development"

PORT=3000
