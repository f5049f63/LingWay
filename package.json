{
  "name": "lingway",
  "private": true,
  "version": "0.1.0",
  "description": "LingWay: сайт для подготовки к поездкам за границу",
  "workspaces": [
    "client",
    "server"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "postinstall": "npm run db:generate -w server",
    "dev": "concurrently -n client,server -c cyan,magenta \"npm run dev -w client\" \"npm run dev -w server\"",
    "dev:client": "npm run dev -w client",
    "dev:server": "npm run dev -w server",
    "build": "npm run build -w client",
    "typecheck": "npm run typecheck -w client && npm run typecheck -w server",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w server",
    "db:deploy": "npm run db:deploy -w server",
    "db:seed": "npm run db:seed -w server",
    "db:studio": "npm run db:studio -w server"
  },
  "devDependencies": {
    "concurrently": "^10.0.7",
    "prettier": "^3.10.1"
  }
}
